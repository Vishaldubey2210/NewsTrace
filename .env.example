
# NewsTrace Environment Variables
# Copy this file to .env and update the values

# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=your-secret-key-here-change-in-production

# Database Configuration
DATABASE_PATH=data/database/newstrace.db

# Scraping Configuration
USER_AGENT_ROTATION=True
RESPECT_ROBOTS_TXT=True
SCRAPING_DELAY=2
MAX_RETRIES=3

# Search API Configuration (Optional)
GOOGLE_SEARCH_ENABLED=True
DUCKDUCKGO_SEARCH_ENABLED=True

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/newstrace.log

# Application Settings
MAX_PROFILES_PER_OUTLET=50
MIN_PROFILES_REQUIRED=30
ENABLE_CACHING=True
CACHE_DURATION=3600

# NLP Settings
SPACY_MODEL=en_core_web_sm
ENABLE_TOPIC_MODELING=True
ENABLE_SENTIMENT_ANALYSIS=True

# Export Settings
DEFAULT_EXPORT_FORMAT=csv
EXPORT_PATH=data/exports/
